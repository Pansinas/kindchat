# ---- Public (exposed to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase "publishable" key (sb_publishable_...) or legacy anon key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Canonical public URL of the app (used in invitation and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Server only (never prefix with NEXT_PUBLIC_) ----
# Supabase "secret" key (sb_secret_...) or legacy service_role key
SUPABASE_SECRET_KEY=sb_secret_xxx
# Domain used for opaque internal auth identities (u.<random>@<domain>).
# Use a subdomain you control with a null MX record so no mail is ever delivered.
AUTH_IDENTITY_DOMAIN=id.kindchat.app
# Random secret (>= 32 chars) used to HMAC client IPs for audit logs
IP_HASH_SECRET=change-me-to-a-long-random-string
# Transactional email (password recovery, recovery-email verification) via Resend.
# If unset, links are printed to the server log in development only.
RESEND_API_KEY=
EMAIL_FROM="KindChat <no-reply@kindchat.app>"
